[Unit]
Description=Afrobot - @AfrocentricBot Telegram news bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=afrobot
WorkingDirectory=/opt/afrobot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/afrobot.env
ExecStart=/opt/afrobot/.venv/bin/python news_bot.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
